{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/data_analysis_validator.py"
          }
        ]
      },
      {
        "matcher": "NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/notebook_organizer.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__ide__executeCode",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Executing data science code...' && date"
          }
        ]
      }
    ]
  }
}
